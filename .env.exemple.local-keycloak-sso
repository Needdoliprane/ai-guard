# Public DEMO settings only / Réglages publics de DÉMONSTRATION uniquement.
# Consumers / Consommateurs: deploy/{docker,podman}/compose.sso.yaml and the
# separate deploy/keycloak-demo/compose.yaml. Never merge the legacy base stack.
# Shell values override this Compose env file / L'environnement du shell prime.
# Choose fresh project names; preserve all existing realms and data volumes.
COMPOSE_PROJECT_NAME=ai-guard-sso
AI_GUARD_CONTROL_IMAGE=agentsandbox-control:local-sso
AI_GUARD_DEMO_CONTROL_IMAGE=agentsandbox-control:local-sso
AI_GUARD_DEMO_IDP_IMAGE=ai-guard-keycloak-demo:local-sso

# REQUIRED: inspect the actual IdP internal network and fill its exact name.
# OBLIGATOIRE : relever le réseau interne réel de l'IdP et son nom exact.
# No project-name inference / Aucun nom déduit du nom de projet.
AI_GUARD_SSO_IDENTITY_NETWORK=

# Frozen values for docs/setup/sso/examples/local-demo.json, fresh realms only.
# Valeurs figées du manifeste public, uniquement pour un realm neuf.
# setup prepare --demo-defaults receives only these five public values and
# rejects incompatible overrides before preparation; it never adapts endpoints.
# setup prepare --demo-defaults reçoit seulement ces cinq valeurs publiques et
# refuse les surcharges incompatibles avant préparation, sans adapter les URL.
# Ordinary startup uses the pinned ports/origin and reopens the prepared volume.
# Le démarrage normal conserve ports/origine fixes et rouvre le volume préparé.
# Issuer / Émetteur: http://keycloak.ai-guard.test:18080/realms/ai-guard-demo
# Resolve the name to host loopback for browser/CLI before starting.
# Résoudre le nom vers le loopback hôte pour navigateur/CLI avant démarrage.
AI_GUARD_DEMO_IDP_HOST=keycloak.ai-guard.test
AI_GUARD_DEMO_IDP_PORT=18080
AI_GUARD_DEMO_WEB_ORIGIN=http://127.0.0.1:4000
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
