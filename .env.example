# Local API credentials only. Never commit real values.
# Subscription authentication does not require these API keys.
# Do not pass this entire file to a worker: select only the active provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Control-plane Jev credential: never forward this value to an agent worker.
JEV_API_KEY=
# Used only with the explicit Jev gateway configuration/Compose override.
# The gateway reads a dedicated raw key file through JEV_API_KEY_FILE, not this dotenv.
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
