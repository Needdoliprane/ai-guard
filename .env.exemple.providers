# Private provider input template / Modèle d'entrée privée des fournisseurs.
# Copy to a NEW private 0600 file; never pass the whole file to a worker.
# Import through the documented providers command; the CLI does not source dotenv.
# Subscription login is configured separately; no API key is needed for that mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Jev is a CONTROL credential: store its raw key in a separate private key file.
# Never include it in a worker credential file.
