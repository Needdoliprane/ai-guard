# Base transport parameters / Paramètres de transport du socle.
# Consumer: Compose --env-file; identities/tenants/IA use their separate typed files.
# Keep loopback publication behind your explicitly configured TLS ingress.
COMPOSE_PROJECT_NAME=ai-guard-enterprise
AGENTSANDBOX_CONFIG_DIR=/srv/ai-guard/config
AI_GUARD_CONTROL_IMAGE=agentsandbox-control:local
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
# Optional TypeSafe configuration; apply ONLY with compose.jev.example.yaml.
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
