# Local stack with the additional finite Rust catalogue / Catalogue Rust local.
# Consumer: base Compose + deploy/docker/compose.jev-rules.example.yaml.
# The override sets JEV_BACKEND inside the gateway; this dotenv file alone does not.
COMPOSE_PROJECT_NAME=ai-guard-local
AGENTSANDBOX_CONFIG_DIR=${HOME}/.ai-guard
AI_GUARD_CONTROL_IMAGE=agentsandbox-control:local
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
