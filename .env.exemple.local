# Public local configuration / Configuration locale publique.
# Consumer: docker compose --env-file .env.exemple.local -f deploy/docker/compose.yaml
# init uses this SAME directory; Compose expands HOME, the CLI does not read this file.
COMPOSE_PROJECT_NAME=ai-guard-local
AGENTSANDBOX_CONFIG_DIR=${HOME}/.ai-guard
AI_GUARD_CONTROL_IMAGE=agentsandbox-control:local
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
