# Consumers: deploy/local-ai/compose.tls-volumes.yaml (separate model project)
# and one control base + deploy/docker/compose.jev-local-tls-volumes.example.yaml.
# Pass this base env FIRST, the provisioner's volumes.env SECOND to Compose.
# Shell interpolation takes precedence: remove conflicting inherited variables.
# volumes.env supplies CA/identity volume names, server name, network and immutable
# control image ID. Do not invent those selectors or source either file.
# No model API credential, TLS source path or private key is consumed here.
COMPOSE_PROJECT_NAME=ai-guard-local
AGENTSANDBOX_CONFIG_DIR=${HOME}/.ai-guard
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
# Replace the model tag with its inspected sha256: image ID before activation.
AI_GUARD_LOCAL_AI_IMAGE=ai-guard-local-ai:qwen2.5-0.5b-q4km
AI_GUARD_LOCAL_AI_MODEL=qwen2.5-0.5b-q4km
AI_GUARD_LOCAL_AI_MEMORY_BYTES=1000000000
AI_GUARD_LOCAL_AI_CPUS=2.0
AI_GUARD_LOCAL_AI_CONTEXT=512
AI_GUARD_LOCAL_AI_DEFAULT_TOKENS=64
