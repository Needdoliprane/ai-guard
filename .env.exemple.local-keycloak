# Local ai-guard + isolated Keycloak / ai-guard local + Keycloak isolé.
# Use this file with the base stack AND the separate Keycloak Compose project.
# Give Keycloak its own -p ai-guard-keycloak on every command; see docs/setup/keycloak/.
COMPOSE_PROJECT_NAME=ai-guard-local
AGENTSANDBOX_CONFIG_DIR=${HOME}/.ai-guard
AI_GUARD_CONTROL_IMAGE=agentsandbox-control:local
AI_GUARD_GATEWAY_PORT=8787
AI_GUARD_DASHBOARD_PORT=4000
AI_GUARD_DEMO_CONTROL_IMAGE=agentsandbox-control:local
AI_GUARD_DEMO_IDP_HOST=keycloak.ai-guard.test
AI_GUARD_DEMO_IDP_PORT=18080
AI_GUARD_DEMO_WEB_ORIGIN=http://127.0.0.1:4000
